# توکن ربات بله
BALE_BOT_TOKEN=PASTE_BALE_BOT_TOKEN_HERE

# سرویس اول: ChatGPT / GapGPT
GAPGPT_API_KEY=PASTE_GAPGPT_API_KEY_HERE

# سرویس دوم: OWEN - بدون نیاز به API
OWEN_API_KEY=

# سرویس سوم: Gemini از طریق OpenRouter
OPENROUTER_API_KEY=PASTE_OPENROUTER_API_KEY_HERE

# شناسه مدیر ربات
ADMIN_ID=955311935

# تنظیمات قابل تغییر سرویس‌ها؛ نام مدل را از مستندات/فهرست رسمی سرویس تأیید کنید.
# GAPGPT_BASE_URL در پروژهٔ قبلی استفاده می‌شد؛ پیش از استقرار، با مستندات فعلی GapGPT تطبیق دهید.
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# تنظیمات اختیاری
BOT_NAME=چت جی پی تی | ChatGPT
OPENROUTER_SITE_URL=https://bale.ai
SQLITE_PATH=/var/data/bot.sqlite3
MAX_INPUT_CHARS=8000
LOG_LEVEL=INFO

# اختیاری: قابلیت‌های رسانه‌ای موجود در نسخهٔ اصلی؛ فقط در صورت استفاده تنظیم شوند.
IMAGE_API_KEY=
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-1
VOICE_API_KEY=
VOICE_API_URL=https://api.openai.com/v1/audio/speech
VOICE_MODEL=gpt-4o-mini-tts
VOICE_NAME=alloy
VIDEO_API_KEY=
VIDEO_CREATE_URL=
VIDEO_STATUS_URL_TEMPLATE=
VIDEO_TIMEOUT_SECONDS=600
VIDEO_POLL_SECONDS=5
WEBHOOK_SECRET=
